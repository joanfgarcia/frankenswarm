{
	"experiment_id": "EXP_024",
	"vocab_size": 8192,
	"hidden_dim": 256,
	"num_layers": 3,
	"use_pos_embedding": true,
	"pop_size": 4,
	"epochs": 40,
	"steps_per_epoch": 200,
	"batch_size": 32,
	"lr": 0.001,
	"weight_decay": 0.1,
	"tau_start": 1.0,
	"tau_min": 0.3,
	"nursery_end": 5,
	"transition_end": 20,
	"tf_min": 0.20,
	"use_logit_mask": true,
	"resume_checkpoint": null,
	"freeze_core": false,
	"svd_interval": 2,
	"svd_phases": ["recreo", "autonomia"],
	"seed": 42,
	"asymmetric_loss_weight": 2.5,
	"operators": {
		"mayor_que": {
			"enabled": true,
			"loss_weight": 1.0
		},
		"menor_que": {
			"enabled": true,
			"loss_weight": 1.0
		},
		"igual_a": {
			"enabled": true,
			"loss_weight": 1.0
		}
	},
	"micro_vocab_words": [
		"cero", "uno", "dos", "tres", "cuatro", "cinco",
		"seis", "siete", "ocho", "nueve", "diez", ">", "<", "igual", "verdad", "falsedad"
	]
}
